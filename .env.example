# ==============================================================================
# ASKARR — Configuration d'environnement (.env.example)
# ==============================================================================
NODE_ENV=development
PORT=4880
SQLITE_DB_PATH=./data/askarr.db

# --- Authentification Cloudflare Access & Rôles ---
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=
ADMIN_EMAILS=admin@example.com
# Uniquement autorisé en NODE_ENV=development ou test (bloque le démarrage en production)
ALLOW_DEV_AUTH_HEADER=true
DEV_DEFAULT_USER_EMAIL=admin@example.com

# --- Fédération Multi-Serveurs Plex (Nom|URL séparés par virgule) ---
# Peut aussi être auto-découvert en 1 clic dans Régie Admin -> Paramètres & Identités
PLEX_SERVERS=Plex-Main|http://192.168.1.50:32400,Plex-Vault|http://192.168.1.51:32400
PLEX_BASE_URL=http://192.168.1.50:32400
PLEX_TOKEN=

# --- Google SMTP (Envoi des Billets d'Invitation VIP par email) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=admin@gmail.com
GOOGLE_MAIL_APP_KEY=

# --- Services Homelab (*arr & Overseerr) ---
OVERSEERR_BASE_URL=http://192.168.1.60:5055
OVERSEERR_API_KEY=

RADARR_BASE_URL=http://192.168.1.70:7878
RADARR_API_KEY=

SONARR_BASE_URL=http://192.168.1.71:8989
SONARR_API_KEY=

PROWLARR_BASE_URL=http://192.168.1.72:9696
PROWLARR_API_KEY=

# --- Tracearr (Analytique Plex, Derniers Ajouts & Historique de Visionnage) ---
TRACEARR_BASE_URL=http://192.168.1.75:3000
TRACEARR_API_KEY=

# --- Cloudflare Zero Trust API (Admin) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CF_ACCESS_TARGET_MODE=group
CF_ACCESS_TARGET_ID=

# --- Fournisseur IA DeepSeek & Quotas ---
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_PRICE_INPUT_CACHE_MISS_PER_1M_USD=0.27
DEEPSEEK_PRICE_INPUT_CACHE_HIT_PER_1M_USD=0.07
DEEPSEEK_PRICE_OUTPUT_PER_1M_USD=1.10
AI_DAILY_TOKEN_CAP=2500000
AI_MONTHLY_BUDGET_USD=10.00
