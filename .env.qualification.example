# =============================================================================
# FICHIER D'EXEMPLE POUR LA QUALIFICATION API (G1) — NE CONTIENT AUCUN SECRET
# Copiez ce fichier vers `.env.qualification` (ignoré par Git) et renseignez
# les valeurs réelles pour autoriser les tests de qualification en lecture.
# =============================================================================

# --- PLEX ---
PLEX_BASE_URL=http://<LAN_HOST_OR_IP>:32400
PLEX_TOKEN=<REPLACE_WITH_PLEX_TOKEN>

# --- OVERSEERR ---
OVERSEERR_BASE_URL=http://<LAN_HOST_OR_IP>:5055
OVERSEERR_API_KEY=<REPLACE_WITH_OVERSEERR_API_KEY>

# --- RADARR ---
RADARR_BASE_URL=http://<LAN_HOST_OR_IP>:7878
RADARR_API_KEY=<REPLACE_WITH_RADARR_API_KEY>

# --- SONARR ---
SONARR_BASE_URL=http://<LAN_HOST_OR_IP>:8989
SONARR_API_KEY=<REPLACE_WITH_SONARR_API_KEY>

# --- PROWLARR ---
PROWLARR_BASE_URL=http://<LAN_HOST_OR_IP>:9696
PROWLARR_API_KEY=<REPLACE_WITH_PROWLARR_API_KEY>

# --- CLOUDFLARE ACCESS (Lecture seule pour G1) ---
CLOUDFLARE_ACCOUNT_ID=<REPLACE_WITH_CF_ACCOUNT_ID>
CLOUDFLARE_API_TOKEN=<REPLACE_WITH_CF_API_TOKEN>
# Optionnel (sera découvert via l'API si omis) :
CLOUDFLARE_ACCESS_APP_ID=<OPTIONAL_CF_APP_ID>
CLOUDFLARE_TEAM_DOMAIN=<OPTIONAL_TEAM_NAME>.cloudflareaccess.com

# --- DEEPSEEK ---
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=<REPLACE_WITH_DEEPSEEK_API_KEY>
DEEPSEEK_MODEL=deepseek-chat

# --- OUTILS ADDITIONNELS ÉVENTUELS (Optionnel — Tautulli / Tracearr) ---
TAUTULLI_BASE_URL=
TAUTULLI_API_KEY=
TRACEARR_BASE_URL=
TRACEARR_API_KEY=
